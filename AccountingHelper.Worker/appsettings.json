{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Redis": { "InstanceName": "accounting-helper:" },
  "Cache": {
    "Dashboard": "00:01:00",
    "Lookups": "01:00:00"
  }
}
